<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS Reverse Proxy Configuration for EMBRACE AI
  
  Prerequisites:
    1. IIS with "WebSocket Protocol" feature enabled
    2. URL Rewrite Module installed
    3. Application Request Routing (ARR) installed and enabled
  
  Place this web.config in the IIS site root (e.g., C:\inetpub\embrace-ai\)
  The Node.js app should be running on localhost:3000
-->
<configuration>
  <system.webServer>

    <!-- Enable WebSocket support (required for Socket.IO quiz/survey) -->
    <webSocket enabled="true" />

    <!-- Reverse proxy rules: forward all requests to Node.js on port 3000 -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{CACHE_URL}" pattern="^(.+)://" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{C:1}" />
            <set name="HTTP_X_ORIGINAL_URL" value="{HTTP_X_ORIGINAL_URL}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- Compression for performance -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
